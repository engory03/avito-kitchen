# Локальные переменные (пример). Скопируй в .env при необходимости.
POSTGRES_USER=kitchen
POSTGRES_PASSWORD=kitchen
POSTGRES_DB=kitchen
DATABASE_URL=postgres://kitchen:kitchen@localhost:5432/kitchen?sslmode=disable

# У каждого сервиса своя переменная HTTP_ADDR (разные процессы).
# kitchen-api:
HTTP_ADDR=:8080

# Ключ, с которым partner-demo ходит в kitchen-api
PARTNER_API_KEY=demo-partner-key

# Куда kitchen шлёт уведомления. Локально без Docker — localhost.
# В Compose используется http://partner-demo:8081
PARTNER_BASE_URL=http://localhost:8081

# Бронь блюда в корзине (минуты)
RESERVATION_TTL_MINUTES=10

# Сколько минут ждать подтверждения заведения (confirm_until)
CONFIRM_TIMEOUT_MINUTES=15

# Таймаут HTTP-уведомления заведению (миллисекунды) — это не confirm_until
PARTNER_HTTP_TIMEOUT_MS=2000

# Кэш витрины каталога (не бронь и не заказы)
REDIS_ADDR=localhost:6379
CATALOG_CACHE_TTL_SECONDS=120

# partner-demo: HTTP_ADDR=:8081 и
# KITCHEN_BASE_URL=http://localhost:8080
# PARTNER_PUBLIC_URL=http://localhost:8081
# Меню и сток — в памяти процесса; confirm/reject по своим остаткам.
