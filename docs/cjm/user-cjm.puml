@startuml AvitoKitchen_User_CJM
title Как пользователь делает заказ (CJM)
skinparam NoteBackgroundColor #FFF8E1

start

:Открыл Авито.Кухня;

if (что хочет сделать?) then (посмотреть прошлые заказы)
  :Открывает историю заказов;
  :Смотрит список\nи статусы прошлых заказов;
  stop
else (сделать новый заказ)
endif

:Смотрит заведения\n(кухня / открыто сейчас);

if (есть подходящие заведения?) then (нет)
  note right
    Боль: по фильтру ничего нет —
    закрыто или не та кухня
  end note
  stop
else (да)
endif

:Выбрал заведение;

if (в меню есть позиции?) then (нет)
  note right
    Нюанс: заведение подключено,
    но меню ещё не заведено
  end note
  stop
else (да)
endif

:Смотрит меню;

if (в корзине уже есть блюда\nиз другого заведения?) then (да)
  note right
    Нюанс: корзина работает только
    с одним заведением одновременно
  end note
  if (готов очистить корзину\nи начать с этим заведением?) then (нет)
    :Остаётся с текущей корзиной;
    stop
  else (да)
    :Старая корзина очищается,\nброни по ней освобождаются;
  endif
else (нет)
endif

:Добавляет блюдо в корзину\n(ставится бронь на 10 минут);

if (остаток свободен?) then (нет)
  note right
    Боль: хотел то же блюдо —
    его уже забронировал кто-то другой
  end note
  stop
else (да)
endif

:В корзине видно,\nдо какого времени держится бронь;

repeat
  if (что делает с корзиной?) then (убрать позицию / уменьшить количество)
    :Бронь на убранное количество\nосвобождается;
  elseif (увеличить количество) then
    if (остаток есть?) then (да)
      :Бронь увеличивается\nна доп. количество;
    else (нет)
      note right
        Боль: хотел добавить больше —
        остатка не хватает
      end note
    endif
  elseif (очистить корзину полностью) then
    :Все брони по корзине\nосвобождаются;
    stop
  else (готов оформлять)
  endif
repeat while (продолжает работать с корзиной?) is (да)
->  нет, переходит к оформлению;

:Система проверяет корзину и заведение;

if (результат проверки?) then (всё доступно)
  :Все позиции идут в заказ;
elseif (доступна только часть) then
  note right
    Боль: часть блюд разобрали
    или бронь на них истекла
  end note
  if (согласен заказать без них?) then (нет)
    :Возвращается в меню;
    stop
  else (да)
    :Продолжает только с доступными позициями;
  endif
else (ничего нельзя заказать)
  :Заказ невозможен\n(заведение закрыто\nили не набралась минимальная сумма);
  stop
endif

:Отправляет заказ\n(с идемпотентным ключом —\nповторный клик не создаст второй заказ);

if (бронь и остаток подтвердились повторно?) then (нет)
  note right
    Нюанс: данные могли устареть между
    проверкой и оформлением — система
    перепроверяет бронь и остаток заново
  end note
  :Повторный частичный отказ или ошибка;
  stop
else (да)
endif

:Заказ создан;

if (хочет отменить заказ?) then (да)
  if (заведение ещё не подтвердило?) then (да)
    :Отменяет заказ;
    :Бронь и остаток возвращаются;
    stop
  else (уже подтвердило и готовит)
    note right
      Нюанс: отмена уже недоступна —
      заведение начало готовить
    end note
  endif
else (нет)
endif

if (заведение ответило сразу?) then (нет)
  :Заказ «ожидает подтверждения»;
  note right
    Нюанс: это не ошибка сервера —
    площадка просто ждёт ответ заведения
  end note

  if (заведение ответило за отведённое время?) then (нет)
    :Заказ автоматически отменяется\nпо тайм-ауту;
    :Бронь и остаток возвращаются;
    note right
      Боль: заведение долго не отвечало —
      заказ снят, чтобы не «висеть» бесконечно
    end note
    stop
  else (да)
  endif
else (да)
endif

if (заведение подтвердило заказ?) then (нет)
  :Заказ отклонён,\nбронь/остаток возвращены;
  note right
    Боль: заведение не смогло выполнить заказ
    (кончились ингредиенты, перегруз)
  end note
  stop
else (да)
endif

:Статус обновляется:\nподтверждён → готовится\n→ в доставке → готов;
:Смотрит финальный статус заказа;

stop

@enduml
